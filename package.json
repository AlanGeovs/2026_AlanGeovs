{
  "name": "alangeovs-sport",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir .build-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "review": "node scripts/review.mjs",
    "test": "vite build --ssr src/prerender.tsx --outDir .build-ssr && node scripts/check-interactions.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "framer-motion": "12.43.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "jsdom": "29.1.1"
  }
}
